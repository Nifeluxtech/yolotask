# Public browser variables. Copy the public values into config.js only.
# The Supabase anon key is safe for browser use only when RLS is configured.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
PAYSTACK_PUBLIC_KEY=pk_test_or_live_public_key
APP_URL=http://localhost:4173

# Server-only Vercel variables. Never expose these in config.js or client code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY
# Set this in the Paystack dashboard (Settings > API Keys & Webhooks) as your
# webhook URL's signing secret, and point the webhook URL at:
#   https://YOUR_DOMAIN/api/payments?action=webhook
# api/payments.js verifies every inbound call against this secret (HMAC-SHA512
# over the raw request body vs. the X-Paystack-Signature header) before
# settling any payment, so this must match what Paystack signs with exactly.
PAYSTACK_WEBHOOK_SECRET=YOUR_PAYSTACK_WEBHOOK_SECRET

# Optional operational controls.
# Enforced by src/server/rate-limit.js on auth (login/register), payments
# (initialize/verify), and withdrawal-creation endpoints. Requires the
# rate_limit_hits table and check_rate_limit() function from
# sql/migrations/018_rate_limiting.sql to be applied in Supabase — without
# that migration, rate limiting fails open (skips silently) rather than
# blocking requests.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
